font-family = JetBrainsMono Nerd Font
font-size = 12
background = #18181c
foreground = #d8dcff
cursor-color = #8aa4ff
selection-background = #3b3570
background-opacity = 0.55
background-blur = 40
window-padding-x = 18
window-padding-y = 14
window-width = 110
window-height = 30
window-theme = dark
gtk-titlebar = true
confirm-close-surface = false
shell-integration = fish
command = /usr/bin/fish -C "command fastfetch -c $HOME/rices/gnome-macos/fastfetch/config.jsonc"
background-opacity-cells = true
